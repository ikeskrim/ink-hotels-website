# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local. Everything here is optional — the site runs without any of
# it, using the content files in src/content/.
# ─────────────────────────────────────────────────────────────────────────────

# ── Content management (Sanity) ──────────────────────────────────────────────
# Written for you by:  npx sanity@latest init --env
# Until these are set, /studio shows a setup page and the site serves its
# built-in content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run `npm run cms:seed`. Create at sanity.io/manage → API →
# Tokens, with Editor permission. Never commit this.
SANITY_API_TOKEN=

# Shared secret for the publish webhook, so an edit appears without a redeploy.
# Set the same value in sanity.io/manage → API → Webhooks, pointing the hook at
# https://your-domain/api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Contact form delivery ────────────────────────────────────────────────────
# Without these the enquiry endpoint returns an honest 503 and the form shows
# the address and phone number instead of faking a success message.
#
# Swap the fetch in src/app/api/contact/route.ts for SendGrid, Postmark or SMTP
# if you prefer — the shape is the same.
RESEND_API_KEY=
CONTACT_FROM="Ink Hotels <website@your-verified-domain.gr>"
CONTACT_TO=creteholidayhome@gmail.com

# ── Chat assistant ───────────────────────────────────────────────────────────
# When set, the assistant appears inside the concierge panel rather than as a
# floating widget. Nothing loads until a guest opens the panel and asks for it.
NEXT_PUBLIC_CHAT_SCRIPT_URL=
NEXT_PUBLIC_CHAT_ID=
NEXT_PUBLIC_CHAT_MOUNT_ID=

# ── Analytics ────────────────────────────────────────────────────────────────
# Plausible: cookieless, no personal data, so this site needs no consent banner.
# Set to the live hostname (no protocol), e.g. inkhotels.gr. Left empty, no
# analytics script is shipped at all.
#
# It only loads in production, so a preview deployment never pollutes the
# owner's numbers.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Offers sign-up ───────────────────────────────────────────────────────────
# The footer email capture stays hidden until this is "1". Turn it on only once
# RESEND_API_KEY is set and /api/contact can actually deliver: a form that
# silently drops an address is worse than no form, because the guest believes
# they subscribed and concludes the hotel ignores people.
NEXT_PUBLIC_OFFERS_SIGNUP=
